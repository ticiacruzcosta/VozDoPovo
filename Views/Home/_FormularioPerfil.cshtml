@Html.AntiForgeryToken()
@using VozDoPovo.Data
@model PerfilModel

@{
    string? pagina = ViewContext.RouteData.Values["action"]?.ToString();
    bool ehLogin = pagina == "Index";
}

<div class="mx-auto" style="max-width: 500px;">
    @if (TempData[MeusIDs.Sucesso] != null)
    {
        <div role="alert" class="alert alert-info d-flex align-items-center justify-content-between rounded-4 shadow-sm mb-4">
            <span class="fw-semibold" style="font-size: 0.88rem;">@TempData[MeusIDs.Sucesso]</span>
            <button type="button" class="btn btn-sm btn-outline-secondary close-alert">X</button>
        </div>
    }

    <div class="vp-card p-4 p-lg-5">
        <!-- Seletor de Abas: Entrar na Conta vs Criar Novo Perfil -->
        <div class="row g-2 p-1 rounded-pill mb-4 mx-0" style="background: var(--vp-surface-alt); border: 1px solid var(--vp-border);">
            <div class="col-6 px-1">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="vp-tab-pill w-100 justify-content-center border-0 text-decoration-none @(ehLogin ? "active" : "")">
                    <span>Entrar na Conta</span>
                </a>
            </div>
            <div class="col-6 px-1">
                <a asp-controller="Home"
                   asp-action="CriarPerfil"
                   class="vp-tab-pill w-100 justify-content-center border-0 text-decoration-none @(!ehLogin ? "active" : "")">
                    <span>Criar Novo Perfil</span>
                </a>
            </div>
        </div>

        <!-- Cabeçalho com Marca -->
        <div class="text-center mb-4">
            <div class="vp-brand-title" style="font-size: 1.55rem;">
                <span class="vp-word-voz">Voz</span>
                <span class="vp-word-do">do</span>
                <span class="vp-word-povo">Povo</span>
            </div>
            <div class="vp-brand-slogan">
                @(ehLogin ? "Acesse sua conta para registrar e acompanhar denúncias" : "Cadastre seu perfil cidadão gratuitamente")
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="nome" class="form-label">Nome de Usuário</label>
            <input asp-for="nome"
                   class="form-control campo-voz"
                   placeholder="Digite seu nome de usuário"
                   required />
            <span asp-validation-for="nome" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="senha" class="form-label">Senha</label>
            <input asp-for="senha"
                   type="password"
                   class="form-control campo-voz"
                   placeholder="Digite a senha da sua conta"
                   required />
            <span asp-validation-for="senha" class="text-danger small"></span>
        </div>

        <div class="p-3 rounded-4 mb-4 d-flex align-items-center gap-2"
             style="background: var(--vp-surface-alt); border: 1px solid var(--vp-border); font-size: 0.78rem; color: var(--vp-text-muted);">
            <svg class="vp-svg-sm" style="color: var(--vp-blue);" viewBox="0 0 24 24">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <span>Você pode publicar denúncias de forma anônima após acessar sua conta.</span>
        </div>

        <div class="d-grid gap-2">
            @if (ehLogin)
            {
                <button type="submit" class="btn-vp-azul py-2">
                    <svg class="vp-svg-sm" viewBox="0 0 24 24">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <polyline points="10 17 15 12 10 7" />
                        <line x1="15" y1="12" x2="3" y2="12" />
                    </svg>
                    <span>Entrar na Conta</span>
                </button>
            }
            else
            {
                <button type="submit" class="btn-vp-verde py-2">
                    <svg class="vp-svg-sm" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="8.5" cy="7" r="4" />
                        <line x1="20" y1="8" x2="20" y2="14" />
                        <line x1="23" y1="11" x2="17" y2="11" />
                    </svg>
                    <span>Criar Meu Perfil Cidadão</span>
                </button>
            }

            <a asp-controller="Home"
               asp-action="Reddit"
               class="btn-vp-neutro py-2 mt-1">
                <span>Continuar navegando como Visitante →</span>
            </a>
        </div>
    </div>
</div>
