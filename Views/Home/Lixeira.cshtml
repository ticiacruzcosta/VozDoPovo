@model List<DenunciaModel>
@{
    ViewData["Title"] = "Arquivo / Denúncias Resolvidas";
    int totalArquivadas = Model?.Count ?? 0;
}

<div class="vp-banner d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
    <div style="max-width: 600px; position: relative; z-index: 2;">
        <div class="vp-banner-pill">
            <svg class="vp-svg-sm" viewBox="0 0 24 24">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <span>HISTÓRICO COMUNITÁRIO</span>
        </div>
        <h2 class="mb-2" style="font-size: 1.6rem; font-weight: 800;">
            Denúncias Arquivadas & Resolvidas
        </h2>
        <p class="mb-0" style="font-size: 0.88rem; opacity: 0.9;">
            Consulte as ocorrências que já foram concluídas ou arquivadas pelos cidadãos.
        </p>
    </div>

    <div class="text-center px-4 py-2 rounded-4" style="background: rgba(255,255,255,0.15); position: relative; z-index: 2;">
        <div style="font-size: 1.35rem; font-weight: 800;">@totalArquivadas</div>
        <div style="font-size: 0.72rem; opacity: 0.85;">Arquivadas</div>
    </div>
</div>

<partial name="_Homepage" />
