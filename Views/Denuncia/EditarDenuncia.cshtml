@model DenunciaModel
@{
    ViewData["Title"] = $"Editar Denúncia #{Model.id}";
}

<div class="vp-banner d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
    <div style="max-width: 620px; position: relative; z-index: 2;">
        <div class="vp-banner-pill">
            <svg class="vp-svg-sm" viewBox="0 0 24 24">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
            </svg>
            <span>ATUALIZAÇÃO DE OCORRÊNCIA</span>
        </div>
        <h2 class="mb-2" style="font-size: 1.6rem; font-weight: 800;">
            Editar Denúncia #@Model.id
        </h2>
        <p class="mb-0" style="font-size: 0.88rem; opacity: 0.9;">
            Atualize as informações, substitua a foto ou ajuste a posição do marcador no mapa.
        </p>
    </div>
</div>

<form asp-action="EditarDenuncia" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="id" />
    <input type="hidden" asp-for="perfil" />
    <input type="hidden" asp-for="likes" />
    <input type="hidden" asp-for="dislikes" />
    <input type="hidden" asp-for="data" />

    <partial name="_Formulario" />
</form>
