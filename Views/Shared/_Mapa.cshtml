@using System.Globalization
@model DenunciaModel

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    #map {
        height: 400px;
        width: 100%;
        border-radius: 18px;
        border: 1.5px solid var(--vp-border);
        z-index: 1;
    }

    .map-coordinates {
        margin-top: 12px;
    }
</style>

<div id="map"></div>
<input type="hidden" id="vp-map-lat" value="@Model.latitude.ToString(CultureInfo.InvariantCulture)" />
<input type="hidden" id="vp-map-lng" value="@Model.longitude.ToString(CultureInfo.InvariantCulture)" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    window.addEventListener('DOMContentLoaded', function () {
        const latEl = document.getElementById("vp-map-lat");
        const lngEl = document.getElementById("vp-map-lng");
        const initialLatitude = parseFloat(latEl ? latEl.value : "-8.769666") || -8.769666;
        const initialLongitude = parseFloat(lngEl ? lngEl.value : "-63.884296") || -63.884296;

        const map = L.map('map').setView([initialLatitude, initialLongitude], 14);
        window.vpLeafletMap = map;

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const isEditable = document.getElementById('edit') !== null;
        const marker = L.marker([initialLatitude, initialLongitude], { draggable: isEditable }).addTo(map);
        window.vpLeafletMarker = marker;

        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');

        function updateCoordinates(latitude, longitude) {
            if (latitudeInput && longitudeInput) {
                latitudeInput.value = latitude.toFixed(6);
                longitudeInput.value = longitude.toFixed(6);
            }
        }

        updateCoordinates(initialLatitude, initialLongitude);

        if (isEditable) {
            marker.bindPopup('Localização selecionada').openPopup();

            map.on('click', function (event) {
                marker.setLatLng(event.latlng);
                updateCoordinates(event.latlng.lat, event.latlng.lng);
                marker.openPopup();
            });

            marker.on('dragend', function (event) {
                const position = event.target.getLatLng();
                updateCoordinates(position.lat, position.lng);
            });
        }
    });
</script>
